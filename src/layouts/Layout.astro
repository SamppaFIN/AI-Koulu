---
import "@fontsource-variable/cinzel";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/atkinson-hyperlegible-mono";
import "../styles/site.css";
import { getCollection } from "astro:content";
import { TECH } from "../data/tech";
import { LINES, PERSONAS } from "../data/crew";
import glossary from "../data/glossary.json";
import { url } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /** Yläpalkin aktiivinen kohta */
  nav?: "ai" | "ux" | "kehae" | "sanasto" | "haku";
}
const { title, description = "Suomenkielinen opetussivusto tekoälyjärjestelmien arkkitehtuurista ja UI/UX-käytännöistä insinööriopiskelijalle.", nav } = Astro.props;

const ai = (await getCollection("ai-architecture", (e) => e.data.published)).sort((a, b) => a.data.order - b.data.order);
const ux = (await getCollection("ui-ux", (e) => e.data.published)).sort((a, b) => a.data.order - b.data.order);
const chapters = [
  ...ai.map((c) => ({ path: `ai-architecture/${c.id}/`, n: c.data.order, title: c.data.title, part: c.data.section, desc: c.data.description, tags: c.data.tags ?? [] })),
  ...ux.map((c) => ({ path: `ui-ux/${c.id}/`, n: c.data.order, title: c.data.title, part: "UI/UX", desc: c.data.description, tags: c.data.tags ?? [] })),
];
const parts = ["Perusteet", "Rakennusmallit", "Agentit", "Tuotanto", "UI/UX"].map((p) => ({ name: p, items: chapters.filter((c) => c.part === p) }));

// Selaimen tarvitsema data yhdessä JSON-lohkossa
const siteData = {
  base: url(""),
  tech: TECH,
  lines: LINES,
  personas: PERSONAS,
  chapters: chapters.map(({ path, n, title, part, desc, tags }) => ({ path, n, title, part, keys: [title, desc, ...tags].join(" ") })),
  glossary: (glossary as { id: string; term: string; shortDef: string }[]).map(({ id, term, shortDef }) => ({ id, term, shortDef })),
};
const cur = (k: string) => (nav === k ? "page" : undefined);
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1630" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={`${title} · AI-Koulu`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fi_FI" />
    <title>{title} · AI-Koulu</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Siirry sisältöön</a>
    <header class="topbar">
      <div class="wrap topbar-row">
        <a class="brand" href={url("")}>
          <svg aria-hidden="true" width="30" height="30" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="none" stroke="oklch(0.82 0.13 85)" stroke-width="2"></circle><circle cx="16" cy="16" r="8" fill="none" stroke="oklch(0.82 0.13 85)" stroke-width="1.2"></circle><path d="M5 25 27 7" stroke="oklch(0.94 0.03 85)" stroke-width="1.6"></path><circle cx="16" cy="16" r="2.2" fill="oklch(0.82 0.13 85)"></circle></svg>
          <span>AI-Koulu</span>
        </a>
        <nav class="nav" aria-label="Päänavigaatio">
          <a href={url("ai-architecture/")} aria-current={cur("ai")}>AI-arkkitehtuurit</a>
          <a href={url("ui-ux/")} aria-current={cur("ux")}>UI/UX</a>
          <a href={url("aikakehae/")} aria-current={cur("kehae")}>Aikakehä</a>
          <a href={url("sanasto/")} aria-current={cur("sanasto")}>Sanasto</a>
        </nav>
        <div class="topbar-tools">
          <a class="btn btn-icon" href={url("haku/")} aria-label="Haku" aria-current={cur("haku")}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          </a>
          <button type="button" class="btn btn-icon" id="map-btn" aria-label="Avaa kartta" aria-haspopup="dialog" aria-controls="map-dialog">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle><circle cx="10" cy="10" r="4" fill="none" stroke="currentColor" stroke-width="1"></circle><path d="M3 16 17 4" stroke="currentColor" stroke-width="1.5"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p>AI-Koulu · Tekijä Infinite</p>
        <p>Koodi MIT · Sisältö CC BY 4.0 · Fontit SIL OFL 1.1</p>
      </div>
    </footer>

    <canvas class="crew-canvas" id="crew" aria-hidden="true"></canvas>
    <p class="crew-bubble" id="crew-bubble" aria-hidden="true"></p>
    <button type="button" class="ask-fab" id="ask-btn" aria-haspopup="dialog" aria-controls="ask-dialog">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M3 4h12v8H8l-4 3v-3H3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
      Kysy
    </button>

    <dialog id="ask-dialog" aria-labelledby="ask-title">
      <div class="dlg">
        <div class="dlg-head">
          <h2 id="ask-title">Kysy insinööreiltä</h2>
          <button type="button" class="btn btn-sm" id="crew-toggle" aria-pressed="false">Piilota insinöörit</button>
          <button type="button" class="btn btn-icon" data-close aria-label="Sulje">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><path d="M2 2 12 12M12 2 2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </div>
        <p class="muted" style="font-size: 0.875rem">Vastaukset tulevat sivuston omasta datasta: luvuista, sanastosta ja insinöörien repliikeistä. Kielimallia ei käytetä.</p>
        <ol class="ask-log" id="ask-log" aria-label="Keskusteluloki" aria-live="polite"></ol>
        <div class="chip-row" id="ask-chips">
          <button type="button" class="btn btn-sm">Mitä kompaktointi on?</button>
          <button type="button" class="btn btn-sm">Missä luvussa on RAG?</button>
          <button type="button" class="btn btn-sm">Mistä aloitan?</button>
        </div>
        <form class="ask-form" id="ask-form">
          <label for="ask-q" class="visually-hidden">Kysymyksesi</label>
          <input id="ask-q" type="text" autocomplete="off" placeholder="Kirjoita kysymys, esim. mitä RAG tarkoittaa" />
          <button type="submit" class="btn btn-primary">Kysy</button>
        </form>
      </div>
    </dialog>

    <dialog id="tech-dialog" aria-labelledby="tech-title">
      <div class="dlg">
        <div class="dlg-head">
          <h2 id="tech-title">Tekniikka</h2>
          <button type="button" class="btn btn-icon" data-close aria-label="Sulje">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><path d="M2 2 12 12M12 2 2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </div>
        <div class="dlg-body">
          <h3 class="eyebrow">Tekniikka</h3><p id="tech-technique"></p>
          <h3 class="eyebrow">Kaava</h3><pre id="tech-formula"></pre>
          <h3 class="eyebrow">Miksi</h3><p id="tech-why"></p>
        </div>
      </div>
    </dialog>

    <dialog id="map-dialog" aria-labelledby="map-title">
      <div class="dlg">
        <div class="dlg-head">
          <h2 id="map-title">Kartta</h2>
          <button type="button" class="btn btn-icon" data-close aria-label="Sulje">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><path d="M2 2 12 12M12 2 2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
          </button>
        </div>
        <div class="dlg-body">
          {parts.map((p) => p.items.length > 0 && (
            <section>
              <h3 class="eyebrow" style="margin-bottom: 4px">{p.name}</h3>
              <ol class="map-list">
                {p.items.map((c) => <li><a href={url(c.path)}><span>{c.n}</span>{c.title}</a></li>)}
              </ol>
            </section>
          ))}
          <p><a href={url("aikakehae/")}>Tekoälyn aikakehä 1950–2026</a> · <a href={url("sanasto/")}>Sanasto</a></p>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="site-data" set:html={JSON.stringify(siteData)}></script>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
