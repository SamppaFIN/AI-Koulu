---
// Staattinen vuokaavio: vaiheet semanttisena listana, nuolet CSS:llä. Ei JavaScriptiä, joten vieritys ja
// näppäimistö toimivat normaalisti, ja ruudunlukija lukee vaiheet järjestyksessä.
export type Step = { title: string; text?: string; kind?: "data" | "process" | "store" | "model" | "tool" };
export type Lane = { title?: string; steps: Step[]; repeat?: string; loop?: string };
// stack: kaistat peräkkäin pystysuunnassa (yksi putki); muuten rinnakkain (esim. indeksointi ja kysely)
interface Props { caption: string; lanes: Lane[]; note?: string; stack?: boolean }
const { caption, lanes, note, stack = false } = Astro.props;
---
<figure class="flow">
  <div class:list={["flow-lanes", { "flow-stack": stack }]} style={`--lanes: ${stack ? 1 : lanes.length}`}>
    {lanes.map((lane) => (
      <div class="flow-lane">
        {lane.title && <p class="flow-lane-title">{lane.title}</p>}
        <ol class:list={["flow-steps", { "flow-repeat": lane.repeat }]} data-repeat={lane.repeat}>
          {lane.steps.map((s) => (
            <li class={`flow-step flow-${s.kind ?? "process"}`}>
              <span class="flow-title">{s.title}</span>
              {s.text && <span class="flow-text">{s.text}</span>}
            </li>
          ))}
        </ol>
        {lane.loop && (
          <p class="flow-loop">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M14 9a5 5 0 1 1-1.5-3.5M14 2v4h-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            {lane.loop}
          </p>
        )}
      </div>
    ))}
  </div>
  <figcaption>{caption}{note && <span class="flow-note"> {note}</span>}</figcaption>
</figure>
