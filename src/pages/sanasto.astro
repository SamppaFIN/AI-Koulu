---
import Layout from "../layouts/Layout.astro";
import glossary from "../data/glossary.json";
type G = { id: string; term: string; shortDef: string; fullDef: string; examples: string[] };
const terms = (glossary as G[]).slice().sort((a, b) => a.term.localeCompare(b.term, "fi"));
---
<Layout title="Sanasto" description="AI-Koulun termit lyhyine määritelmineen" nav="sanasto">
  <div class="chapter-head"><div class="wrap">
    <p class="eyebrow">{terms.length} termiä</p>
    <h1>Sanasto</h1>
    <p class="lead">Termit ovat samat kuin luvuissa. Lyhyt määritelmä ensin, tarkennus sen jälkeen.</p>
  </div></div>
  <div class="wrap" style="padding-block: 32px 96px" data-attn="sanasto">
    <ul class="glossary">
      {terms.map((t) => (
        <li id={t.id}>
          <h2 style="font-size: 1.125rem">{t.term}</h2>
          <p>{t.shortDef}</p>
          <details><summary class="muted" style="cursor: pointer; min-height: 32px">Tarkemmin</summary><p style="margin-top: 6px">{t.fullDef}</p>
            {t.examples.length > 0 && <ul style="margin: 8px 0 0; padding-left: 1.2em">{t.examples.map((e) => <li class="muted">{e}</li>)}</ul>}
          </details>
        </li>
      ))}
    </ul>
  </div>
</Layout>
