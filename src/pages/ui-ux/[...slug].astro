---
import ChapterPage from "../../components/site/ChapterPage.astro";
import { chapters } from "../../lib/chapters";

export async function getStaticPaths() {
  return (await chapters("ui-ux")).map((chapter) => ({ params: { slug: chapter.id }, props: { chapter } }));
}
const { chapter } = Astro.props;
---
<ChapterPage chapter={chapter} coll="ui-ux" />
