---
import Layout from "../../layouts/Layout.astro";
import { chapters } from "../../lib/chapters";
import { url } from "../../lib/url";
const ux = await chapters("ui-ux");
---
<Layout title="UI/UX-käytännöt" nav="ux">
  <div class="chapter-head"><div class="wrap">
    <p class="eyebrow">{ux.length} lukua</p>
    <h1>UI/UX-käytännöt</h1>
    <p class="lead">Ihmiskeskeinen suunnittelu, saavutettavuus, suorituskyky ja tekoälyn vaikutus käyttöliittymiin.</p>
  </div></div>
  <div class="wrap" style="padding-block: 32px 96px" data-attn="uiux">
    <ol class="ux-list">
      {ux.map((c) => (
        <li><a href={url(`ui-ux/${c.id}/`)} data-path={`ui-ux/${c.id}/`} data-attn={`ch:ui-ux/${c.id}`}>
          <span class="n">{c.data.order}</span>
          <span class="t"><span style="font-weight: 700">{c.data.title}</span><small>{c.data.description}</small></span>
        </a></li>
      ))}
    </ol>
  </div>
</Layout>
