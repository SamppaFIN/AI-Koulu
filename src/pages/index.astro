---
import Layout from "../layouts/Layout.astro";
import Astrolabe from "../components/site/Astrolabe.astro";
import TechTag from "../components/site/TechTag.astro";
import PartList from "../components/site/PartList.astro";
import { chapters } from "../lib/chapters";
import { CONCEPTS } from "../data/aikakehae";
import { url } from "../lib/url";

const ux = await chapters("ui-ux");
const ai = await chapters("ai-architecture", { drafts: true });
---
<Layout title="Etusivu">
  <section class="hero" aria-labelledby="h-hero" data-attn="hero">
    <div class="hero-art"><Astrolabe /></div>
    <div class="wrap hero-inner">
      <div class="hero-card">
        <p class="eyebrow">Tekoälyjärjestelmien arkkitehtuuri · tilanne 11/2026</p>
        <h1 id="h-hero">AI-Koulu</h1>
        <p class="lead">Kielimallit, konteksti, RAG, agentit ja niiden käyttöliittymät insinööriopiskelijalle: miten ne toimivat, mitä ne maksavat ja miten niitä testataan.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={url(`ai-architecture/${ai[0].id}/`)}>Aloita luvusta 1</a>
          <a class="btn" href="#osat">Lukujärjestys</a>
        </div>
        <a class="continue" href={url("")}>
          <span class="muted" style="font-size: 0.875rem">Jatka siitä, mihin jäit</span>
          <span class="continue-title" style="font-weight: 700"></span>
          <progress value="0" max="1" aria-label="Luettujen lukujen määrä"></progress>
          <span class="continue-count muted" style="font-size: 0.875rem"></span>
        </a>
      </div>
      <div class="hero-foot"><TechTag id="hero" label="astrolabi ja WebGL" /></div>
    </div>
  </section>

  <div class="sections" style="margin-top: var(--section-gap)">
    <section class="sec wrap" id="osat" aria-labelledby="h-osat" data-attn="parts">
      <canvas class="scape" data-scape="glyphs" aria-hidden="true"></canvas>
      <div class="sec-head">
        <div>
          <p class="eyebrow">{ai.length} lukua neljässä osassa</p>
          <h2 id="h-osat">AI-arkkitehtuurit</h2>
          <p class="muted" style="max-width: 62ch">Osat etenevät mallista sovellukseen, agenttiin ja tuotantoon. Luvut etenevät määritelmästä mekanismiin ja esimerkkiin, ja aikasidonnaisten väitteiden lähteet on merkitty.</p>
        </div>
        <TechTag id="glyphs" label="kirjaimet hajoavat tokeneiksi" />
      </div>
      <PartList />
    </section>

    <section class="sec wrap" id="uiux" aria-labelledby="h-uiux" data-attn="uiux">
      <div class="scape-colonnade" aria-hidden="true"></div>
      <div class="sec-head">
        <div>
          <p class="eyebrow">{ux.length} lukua</p>
          <h2 id="h-uiux">UI/UX-käytännöt</h2>
        </div>
        <TechTag id="colonnade" label="pylväikkö clip-pathilla" />
      </div>
      <ol class="ux-list">
        {ux.map((c) => (
          <li><a href={url(`ui-ux/${c.id}/`)} data-path={`ui-ux/${c.id}/`} data-attn={`ch:ui-ux/${c.id}`}>
            <span class="n">{c.data.order}</span>
            <span class="t"><span style="font-weight: 700">{c.data.title}</span><small>{c.data.description}</small></span>
          </a></li>
        ))}
      </ol>
    </section>

    <section class="sec wrap" aria-labelledby="h-kehae" data-attn="kehae">
      <div class="scape-sweep" aria-hidden="true"></div>
      <div class="kehae-teaser">
        <div>
          <p class="eyebrow">1950–2026</p>
          <h2 id="h-kehae">Tekoälyn aikakehä</h2>
          <p class="muted" style="max-width: 60ch">{CONCEPTS.length} käsitettä julkaisuvuoden mukaan Turingin testistä vuoden 2026 adaptiiviseen päättelyyn. Jokaisesta pääsee lukuun, jossa se opetetaan.</p>
          <div class="chip-row" style="align-items: center">
            <a class="btn" href={url("aikakehae/")}>Avaa aikakehä</a>
            <TechTag id="sweep" label="@property-pyyhkäisy" />
          </div>
        </div>
        <Astrolabe variant="mini" label={`Pienoiskuva aikakehästä: ${CONCEPTS.length} käsitettä neljällä renkaalla`} />
      </div>
    </section>

    <section class="sec wrap" id="sanasto" aria-labelledby="h-sanasto" data-attn="sanasto">
      <canvas class="scape" data-scape="flow" aria-hidden="true"></canvas>
      <div class="sec-head">
        <div>
          <h2 id="h-sanasto">Sanasto ja haku</h2>
          <p class="muted" style="max-width: 60ch">Sanaston termit ovat samat kuin luvuissa. Luvun tekstissä termin määritelmä aukeaa osoittimella tai fokuksella.</p>
        </div>
        <TechTag id="flow" label="virtauskenttä" />
      </div>
      <form class="ask-form" action={url("haku/")} method="get" style="max-width: 560px">
        <label for="home-q" class="visually-hidden">Hae luvuista ja sanastosta</label>
        <input id="home-q" name="q" type="search" placeholder="esim. kompaktointi" />
        <button class="btn btn-primary" type="submit">Hae</button>
      </form>
      <p style="margin-top: 14px"><a href={url("sanasto/")}>Koko sanasto</a></p>
    </section>
  </div>
</Layout>
